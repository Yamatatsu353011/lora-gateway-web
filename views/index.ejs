<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>LoRa Gateway GPS Dashboard</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard-theme.css">

  <style>
    .map-legend { display:flex; flex-wrap:wrap; gap:10px 18px;
      padding:10px 8px 4px; color:#e7f2ff; font-size:12px; }
    .map-legend span { display:inline-flex; align-items:center; gap:6px; }
    .map-legend-dot { width:12px; height:12px; border-radius:50%;
      display:inline-block; border:2px solid rgba(255,255,255,.65); }
    .map-base { background:#df3a3a; }
    .map-mobile { background:#3388ff; }
    .map-detection { background:#ff9f1c; }
    .map-unknown { background:#9099a5; }
    .node-icon-unknown { filter:grayscale(1); }
  </style>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
  </script>
</head>

<body class="dashboard-page">
  <div class="dashboard-layout">
    <aside class="dashboard-sidebar">
      <div class="sidebar-brand">
        <span class="brand-symbol" aria-hidden="true">◈</span>
        <div><strong>災害支援システム</strong><small>災害対策本部</small></div>
      </div>
      <div class="sidebar-section-title">メインメニュー</div>
      <nav class="dashboard-nav" aria-label="メインメニュー">
        <a class="active" href="/">◈ &nbsp; GPS Dashboard</a>
        <a href="/mobile">▣ &nbsp; Mobile Home</a>
        <a href="/orders/new">⊕ &nbsp; 新規発注</a>
        <a href="/orders">▤ &nbsp; 発注一覧</a>
        <a href="/requests">◉ &nbsp; 受注画面</a>
      </nav>
      <div class="sidebar-footer"><span class="sidebar-status-dot"></span>災害支援ネットワーク</div>
    </aside>
    <div class="dashboard-content">
      <header class="dashboard-topbar">
        <div>
          <div class="topbar-label">災害対策本部 ／ 総合監視</div>
          <h1>LoRa Gateway GPS Dashboard</h1>
        </div>
        <div class="topbar-right"><span class="system-label">LoRa通信拠点</span></div>
      </header>
      <main class="dashboard-main">
        <section class="status-cards" aria-label="通信状態の概要">
          <div class="status-card"><div class="status-card-label">GPS測位状態</div><div class="status-card-value" id="summary-gps">-</div><div class="status-card-footer">GPS STATUS</div></div>
          <div class="status-card"><div class="status-card-label">接続ノード数</div><div class="status-card-value" id="summary-nodes">-</div><div class="status-card-footer">LoRa NODES</div></div>
          <div class="status-card"><div class="status-card-label">送信キュー</div><div class="status-card-value" id="summary-tx">-</div><div class="status-card-footer">TX QUEUE</div></div>
          <div class="status-card"><div class="status-card-label">受信キュー</div><div class="status-card-value" id="summary-rx">-</div><div class="status-card-footer">RX QUEUE</div></div>
        </section>


    <div class="card">
      <div id="map"></div>
      <div class="map-legend" aria-label="地図の凡例">
        <span><i class="map-legend-dot map-base"></i> BASE</span>
        <span><i class="map-legend-dot map-mobile"></i> MOBILE</span>
        <span><i class="map-legend-dot map-detection"></i> 物体検出</span>
        <span><i class="map-legend-dot map-unknown"></i> 未分類</span>
      </div>
    </div>


    <div class="grid">

      <div class="card">
        <h3>Position</h3>

        <table>
          <tr>
            <td>Latitude</td>
            <td id="lat">-</td>
          </tr>

          <tr>
            <td>Longitude</td>
            <td id="lon">-</td>
          </tr>

          <tr>
            <td>Altitude</td>
            <td id="alt">-</td>
          </tr>

          <tr>
            <td>Fix</td>
            <td id="fix_status">-</td>
          </tr>

          <tr>
            <td>GPS Time</td>
            <td id="gps_time">-</td>
          </tr>

          <tr>
            <td>Updated</td>
            <td id="updated_at">-</td>
          </tr>
        </table>

      </div>


      <div class="card">
        <h3>Satellite / DOP</h3>

        <table>
          <tr>
            <td>Satellites Seen</td>
            <td id="satellites_seen">-</td>
          </tr>

          <tr>
            <td>Satellites Used</td>
            <td id="satellites_used">-</td>
          </tr>

          <tr>
            <td>HDOP</td>
            <td id="hdop">-</td>
          </tr>

          <tr>
            <td>PDOP</td>
            <td id="pdop">-</td>
          </tr>

          <tr>
            <td>TDOP</td>
            <td id="tdop">-</td>
          </tr>

          <tr>
            <td>GDOP</td>
            <td id="gdop">-</td>
          </tr>
        </table>

      </div>


      <div class="card">
        <h3>Time Sync</h3>

        <table>
          <tr>
            <td>Time Offset</td>
            <td id="time_offset">-</td>
          </tr>

          <tr>
            <td>Chrony</td>
            <td id="chrony_status">-</td>
          </tr>

          <tr>
            <td>Server Time</td>
            <td id="server_time">-</td>
          </tr>
        </table>

      </div>


      <div class="card">
        <h3>LoRa Queue</h3>

        <table>
          <tr>
            <td>TX Queue</td>
            <td id="queue_tx">-</td>
          </tr>

          <tr>
            <td>RX Queue</td>
            <td id="queue_rx">-</td>
          </tr>
        </table>

      </div>

    </div>


    <div class="card">
      <h3>Raw GPS State</h3>

      <pre id="raw_gps">-</pre>
    </div>

      </main>
    </div>
  </div>


  <script>

    let map = L.map("map").setView(
      [37.523, 139.939],
      16
    );


    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors"
      }
    ).addTo(map);


    // ============================================================
    // Gateway自身のGPSマーカー
    // ============================================================

    const baseStationIcon = new L.Icon({
      iconUrl: "/images/marker-icon-red.png",
      shadowUrl: "/images/marker-shadow.png",
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41]
    });

    const unknownNodeIcon = new L.Icon({
      iconUrl: "/images/marker-icon-red.png",
      shadowUrl: "/images/marker-shadow.png",
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
      className: "node-icon-unknown"
    });

    const mobileNodeIcon = new L.Icon.Default();

    let marker = L.marker(
      [37.523, 139.939],
      { icon: baseStationIcon }
    ).addTo(map);

    let firstFix = true;

    // ============================================================
    // LoRaで受信した移動ノード用マーカー
    //
    // nodeMarkers["0001"]
    // nodeMarkers["0002"]
    // ...
    // ============================================================

    const nodeMarkers = {};
    const nodeMarkerTypes = {};
    const detectionMarkers = new Map();
    let lastDetectionFetch = 0;

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (ch) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;",
        '"': "&quot;", "'": "&#39;"
      })[ch]);
    }

    function getNodeType(value) {
      const type = String(value || "").toLowerCase();
      return type === "base" || type === "mobile" ? type : "unknown";
    }

    function getNodeIcon(type) {
      return type === "base" ? baseStationIcon :
        type === "mobile" ? mobileNodeIcon : unknownNodeIcon;
    }

    async function updateDetectionMarkers() {
      // Position monitoring runs every second; event history is polled every 5s.
      if (Date.now() - lastDetectionFetch < 5000) return;
      lastDetectionFetch = Date.now();

      try {
        const response = await fetch("/api/detections", { cache: "no-store" });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const { detections = [] } = await response.json();
        const currentIds = new Set();

        for (const detection of detections) {
          const id = String(detection.event_id);
          if (!id) continue;
          const lat = Number(detection.lat);
          const lon = Number(detection.lon);
          if (!Number.isFinite(lat) || !Number.isFinite(lon)) continue;
          currentIds.add(id);

          let dot = detectionMarkers.get(id);
          if (!dot) {
            dot = L.circleMarker([lat, lon], {
              radius: 9, color: "#8c4300", weight: 2,
              fillColor: "#ff9f1c", fillOpacity: 0.9
            }).addTo(map);
            detectionMarkers.set(id, dot);
          } else {
            dot.setLatLng([lat, lon]);
          }

          const timestamp = Number(detection.received_at);
          const receivedAt = Number.isFinite(timestamp) && timestamp > 0
            ? new Date(timestamp * 1000).toLocaleString("ja-JP") : "-";
          dot.bindPopup(
            `<strong>物体検出</strong><br>` +
            `Node: ${escapeHtml(detection.node_id)}<br>` +
            `Event: ${escapeHtml(id)}<br>` +
            `受信日時: ${escapeHtml(receivedAt)}<br>` +
            `Lat: ${lat.toFixed(7)}<br>Lon: ${lon.toFixed(7)}`
          );
        }

        for (const [id, dot] of detectionMarkers) {
          if (!currentIds.has(id)) {
            map.removeLayer(dot);
            detectionMarkers.delete(id);
          }
        }
      } catch (err) {
        console.error("[DETECTION-MARKER-ERR]", err);
      }
    }


    function fmt(
      value,
      digits = null,
      suffix = ""
    ) {

      if (
        value === null ||
        value === undefined ||
        value === "" ||
        value === "n/a"
      ) {
        return "-";
      }


      if (
        typeof value === "number" &&
        digits !== null
      ) {

        return (
          value.toFixed(digits) +
          suffix
        );

      }


      return (
        String(value) +
        suffix
      );
    }


    function setText(
      id,
      value
    ) {

      const el =
        document.getElementById(id);

      if (el) {
        el.textContent = value;
      }

    }


    function classifyFix(fix) {

      if (fix === "3D") {
        return "ok";
      }


      if (
        fix === "2D" ||
        fix === "FIX"
      ) {
        return "warn";
      }


      return "bad";
    }


    function extractTimeOffset(
      timeSync
    ) {

      if (!timeSync) {
        return "-";
      }


      if (
        timeSync.offset_ms !== undefined &&
        timeSync.offset_ms !== null
      ) {

        return fmt(
          timeSync.offset_ms,
          3,
          " ms"
        );

      }


      if (
        typeof timeSync.tracking ===
        "string"
      ) {

        const m =
          timeSync.tracking.match(
            /System time\s*:\s*([+-]?[0-9.]+)\s*seconds/i
          );


        if (m) {

          const sec =
            Number(m[1]);


          if (
            !Number.isNaN(sec)
          ) {

            return (
              sec * 1000
            ).toFixed(3) + " ms";

          }

        }

      }


      return "-";
    }


    // ============================================================
    // LoRa mobile nodes
    // ============================================================

    async function updateNodeMarkers() {

      try {

        const res =
          await fetch(
            "/api/nodes",
            {
              cache: "no-store"
            }
          );


        if (!res.ok) {

          throw new Error(
            `HTTP ${res.status}`
          );

        }


        const data =
          await res.json();


        const nodes =
          data.nodes || [];

        setText("summary-nodes", nodes.length);


        for (
          const node of nodes
        ) {

          const nodeId =
            String(
              node.node_id
            );

          const incomingType = getNodeType(node.node_type);
          // Once a node is identified as BASE, subsequent POS must not
          // overwrite its red marker with a blue one.
          const nodeType = nodeMarkerTypes[nodeId] === "base"
            ? "base" : incomingType;


          const lat =
            Number(
              node.lat
            );


          const lon =
            Number(
              node.lon
            );


          if (
            Number.isNaN(lat) ||
            Number.isNaN(lon)
          ) {

            continue;

          }


          // --------------------------------------------------------
          // 既存ノードなら座標だけ更新
          // --------------------------------------------------------

          if (
            nodeMarkers[nodeId]
          ) {

            nodeMarkers[nodeId]
              .setLatLng([
                lat,
                lon
              ]);

            if (nodeMarkerTypes[nodeId] !== nodeType) {
              nodeMarkers[nodeId].setIcon(getNodeIcon(nodeType));
            }

          }

          // --------------------------------------------------------
          // 初めて受信したノード
          // --------------------------------------------------------

          else {

            nodeMarkers[nodeId] =
              L.marker([
                lat,
                lon
              ], { icon: getNodeIcon(nodeType) }).addTo(map);

          }


          // --------------------------------------------------------
          // Popup
          // --------------------------------------------------------

          nodeMarkerTypes[nodeId] = nodeType;

          nodeMarkers[nodeId]
            .bindPopup(
              `Node: ${escapeHtml(nodeId)}<br>` +
              `Type: ${nodeType.toUpperCase()}<br>` +
              `Lat: ${lat.toFixed(7)}<br>` +
              `Lon: ${lon.toFixed(7)}`
            );

        }


      } catch (err) {

        console.error(
          "[NODE-MARKER-ERR]",
          err
        );

      }

    }


    // ============================================================
    // Dashboard
    // ============================================================

    async function updateDashboard() {

      try {

        const res =
          await fetch(
            "/api/state",
            {
              cache: "no-store"
            }
          );


        const state =
          await res.json();


        const gps =
          state.self || state.gps || {};


        const timeSync =
          state.time_sync || {};


        const queue =
          state.queue || {};


        const lat =
          Number(
            gps.lat
          );


        const lon =
          Number(
            gps.lon
          );


        // ========================================================
        // Gateway自身の位置
        // ========================================================

        if (
          !Number.isNaN(lat) &&
          !Number.isNaN(lon)
        ) {

          marker.setLatLng([
            lat,
            lon
          ]);


          marker.bindPopup(
            `Lat: ${lat.toFixed(7)}<br>` +
            `Lon: ${lon.toFixed(7)}<br>` +
            `Alt: ${fmt(
              gps.alt,
              2,
              " m"
            )}`
          );


          if (firstFix) {

            map.setView(
              [
                lat,
                lon
              ],
              17
            );


            firstFix = false;

          }

        }


        // ========================================================
        // Position
        // ========================================================

        setText(
          "lat",
          fmt(
            gps.lat,
            8
          )
        );


        setText(
          "lon",
          fmt(
            gps.lon,
            8
          )
        );


        setText(
          "alt",
          fmt(
            gps.alt,
            2,
            " m"
          )
        );


        setText(
          "fix_status",
          fmt(
            gps.fix_status ||
            gps.mode
          )
        );


        document
          .getElementById(
            "fix_status"
          )
          .className =
            classifyFix(
              gps.fix_status
            );


        setText(
          "gps_time",
          fmt(
            gps.gps_time
          )
        );


        setText(
          "updated_at",
          fmt(
            gps.updated_at
          )
        );


        // ========================================================
        // Satellite
        // ========================================================

        setText(
          "satellites_seen",
          fmt(
            gps.satellites_seen
          )
        );


        setText(
          "satellites_used",
          fmt(
            gps.satellites_used
          )
        );


        setText(
          "hdop",
          fmt(
            gps.hdop,
            2
          )
        );


        setText(
          "pdop",
          fmt(
            gps.pdop,
            2
          )
        );


        setText(
          "tdop",
          fmt(
            gps.tdop,
            2
          )
        );


        setText(
          "gdop",
          fmt(
            gps.gdop,
            2
          )
        );


        // ========================================================
        // Time
        // ========================================================

        setText(
          "time_offset",
          extractTimeOffset(
            timeSync
          )
        );


        setText(
          "chrony_status",
          timeSync.tracking
            ? "available"
            : "-"
        );


        setText(
          "server_time",
          fmt(
            state.server_time
          )
        );


        // ========================================================
        // LoRa Queue
        // ========================================================

        setText(
          "queue_tx",
          fmt(
            queue.lora_tx
          )
        );


        setText(
          "queue_rx",
          fmt(
            queue.lora_rx
          )
        );

        setText("summary-gps", fmt(gps.fix_status || gps.mode));
        setText("summary-tx", fmt(queue.lora_tx));
        setText("summary-rx", fmt(queue.lora_rx));


        // ========================================================
        // Raw GPS
        // ========================================================

        setText(
          "raw_gps",
          JSON.stringify(
            gps,
            null,
            2
          )
        );


        // ========================================================
        // Mobile node markers
        // ========================================================

        await updateNodeMarkers();
        await updateDetectionMarkers();


      } catch (err) {

        console.error(
          err
        );

      }

    }


    // ============================================================
    // Start
    // ============================================================

    updateDashboard();

    setInterval(
      updateDashboard,
      1000
    );

  </script>

</body>
</html>
