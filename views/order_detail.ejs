<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>発注詳細</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header>
    <h1>発注詳細</h1>
  </header>

  <main>
    <nav>
      <a href="/mobile">Mobile Home</a>
      <a href="/">GPS Dashboard</a>
      <a href="/orders">発注一覧</a>
      <a href="/orders/new">新規発注</a>
      <a class="primary" href="/requests/<%= order.order_id %>/reply">この発注に受注Reply</a>
    </nav>

    <div class="card">
      <h2>基本情報</h2>
      <table>
        <tr><th>Order ID</th><td><%= order.order_id %></td></tr>
        <tr><th>発注ノード</th><td><%= order.requester_node %></td></tr>
        <tr><th>対象領域</th><td><%= order.target_area %></td></tr>
        <tr>
          <th>対象点</th>
          <td>
            <% if (order.target_lat && order.target_lon) { %>
              <%= Number(order.target_lat).toFixed(8) %>,
              <%= Number(order.target_lon).toFixed(8) %>
            <% } else { %>
              -
            <% } %>
          </td>
        </tr>

        <tr>
          <th>対象範囲</th>
          <td>
            <% if (order.target_size_m) { %>
              Level <%= order.target_level %> /
              <%= order.target_size_m %> m square
            <% } else { %>
              -
            <% } %>
          </td>
        </tr>

        <tr>
          <th>対象領域ラベル</th>
          <td><%= order.target_area_label || "-" %></td>
        </tr>
        <tr><th>状態</th><td class="status-<%= order.status %>"><%= order.status %></td></tr>
        <tr><th>備考</th><td><%= order.note %></td></tr>
        <tr><th>作成日時</th><td><%= order.created_at %></td></tr>
        <tr><th>更新日時</th><td><%= order.updated_at %></td></tr>
      </table>
    </div>

    <div class="card">
      <h2>物資別充足状況</h2>
      <table class="responsive-table">
        <thead>
          <tr>
            <th>カテゴリ</th>
            <th>品目</th>
            <th>必要数</th>
            <th>受け数</th>
            <th>残数</th>
            <th>単位</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(i => { %>
            <tr>
              <td data-label="カテゴリ"><%= i.category %></td>
              <td data-label="品目"><%= i.item_name %></td>
              <td data-label="必要数"><%= i.requested_qty %></td>
              <td data-label="受け数"><%= i.accepted_qty %></td>
              <td data-label="残数"><%= i.remaining_qty %></td>
              <td data-label="単位"><%= i.unit %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>受注Reply一覧</h2>
      <table class="responsive-table">
        <thead>
          <tr>
            <th>Offer ID</th>
            <th>応答ノード</th>
            <th>状態</th>
            <th>備考</th>
            <th>作成日時</th>
          </tr>
        </thead>
        <tbody>
          <% offers.forEach(o => { %>
            <tr>
              <td data-label="Offer ID"><%= o.offer_id %></td>
              <td data-label="応答ノード"><%= o.responder_node %></td>
              <td data-label="状態"><%= o.status %></td>
              <td data-label="備考"><%= o.note %></td>
              <td data-label="作成日時"><%= o.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>受注Reply内訳</h2>
      <table class="responsive-table">
        <thead>
          <tr>
            <th>Offer ID</th>
            <th>応答ノード</th>
            <th>品目</th>
            <th>提供可能数</th>
            <th>受け入れ数</th>
            <th>単位</th>
          </tr>
        </thead>
        <tbody>
          <% offerItems.forEach(i => { %>
            <tr>
              <td data-label="Offer ID"><%= i.offer_id %></td>
              <td data-label="応答ノード"><%= i.responder_node %></td>
              <td data-label="品目"><%= i.item_name %></td>
              <td data-label="提供可能数"><%= i.offered_qty %></td>
              <td data-label="受け入れ数"><%= i.accepted_qty %></td>
              <td data-label="単位"><%= i.unit %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
