<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Received Messages</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/business-theme.css">
</head>

<body class="business-page">
  <header>
    <h1>Received Messages</h1>
  </header>

  <main>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/messages">Messages</a>
      <a href="/send">Send</a>
    </nav>

    <div class="orders-table-scroll">
      <table>
        <tr>
          <th>ID</th>
          <th>Packet ID</th>
          <th>Source</th>
          <th>Previous</th>
          <th>Destination</th>
          <th>BST Prefix</th>
          <th>Payload</th>
          <th>RSSI</th>
          <th>SNR</th>
          <th>Hop</th>
          <th>TTL</th>
          <th>Received At</th>
        </tr>

        <% rows.forEach(row => { %>
          <tr>
            <td><%= row.id %></td>
            <td><%= row.packet_id %></td>
            <td><%= row.source_node %></td>
            <td><%= row.previous_node %></td>
            <td><%= row.destination_node %></td>
            <td><%= row.target_bst_prefix %></td>
            <td><%= row.payload_text %></td>
            <td><%= row.rssi %></td>
            <td><%= row.snr %></td>
            <td><%= row.hop_count %></td>
            <td><%= row.ttl %></td>
            <td><%= row.received_at %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </main>
</body>
</html>
